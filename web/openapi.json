  "components": {
    "schemas": {
      "AerialMeta": {
        "properties": {
          "stack": {
            "type": "string",
            "title": "Stack"
          },
          "x0": {
            "type": "number",
            "title": "X0"
          },
          "z0": {
            "type": "number",
            "title": "Z0"
          },
          "res": {
            "type": "number",
            "title": "Res"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stack",
          "x0",
          "z0",
          "res",
          "width",
          "height"
        ],
        "title": "AerialMeta",
        "description": "Where a bundle's aerial image sits in course metres (x east, z south) and its pixel size."
      },
      "BakeRequest": {
        "properties": {
          "stack": {
            "type": "string",
            "title": "Stack"
          },
          "out": {
            "type": "string",
            "title": "Out"
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "title": "Name"
          },
          "attribution": {
            "type": "string",
            "pattern": "\\S",
            "title": "Attribution",
            "default": "Elevation: USGS 3DEP. Imagery: NAIP."
          },
          "replace": {
            "type": "boolean",
            "title": "Replace",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stack",
          "out",
          "name"
        ],
        "title": "BakeRequest"
      },
      "BakeResult": {
        "properties": {
          "bundle": {
            "type": "string",
            "title": "Bundle"
          },
          "report": {
            "$ref": "#/components/schemas/Report"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bundle",
          "report"
        ],
        "title": "BakeResult"
      },
      "BundleEntry": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "name"
        ],
        "title": "BundleEntry"
      },
      "Course": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S",
            "title": "Name"
          },
          "attribution": {
            "type": "string",
            "pattern": "\\S",
            "title": "Attribution"
          },
          "crs": {
            "type": "string",
            "pattern": "\\S",
            "title": "Crs"
          },
          "originEasting": {
            "type": "number",
            "title": "Origineasting"
          },
          "originNorthing": {
            "type": "number",
            "title": "Originnorthing"
          },
          "hMin": {
            "type": "number",
            "title": "Hmin"
          },
          "hMax": {
            "type": "number",
            "title": "Hmax"
          },
          "height": {
            "$ref": "#/components/schemas/Grid"
          },
          "class": {
            "$ref": "#/components/schemas/Grid"
          },
          "bounds": {
            "$ref": "#/components/schemas/Grid"
          },
          "patches": {
            "items": {
              "$ref": "#/components/schemas/Patch"
            },
            "type": "array",
            "title": "Patches",
            "default": []
          },
          "trees": {
            "$ref": "#/components/schemas/TreesRef"
          },
          "landmarks": {
            "items": {
              "$ref": "#/components/schemas/Landmark"
            },
            "type": "array",
            "title": "Landmarks",
            "default": []
          },
          "holes": {
            "items": {
              "$ref": "#/components/schemas/Hole"
            },
            "type": "array",
            "title": "Holes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "attribution",
          "crs",
          "originEasting",
          "originNorthing",
          "hMin",
          "hMax",
          "height",
          "class",
          "bounds",
          "patches",
          "trees",
          "landmarks",
          "holes"
        ],
        "title": "Course"
      },
      "EditorResponse": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/EditorState-Output"
          },
          "status": {
            "type": "string",
            "enum": [
              "default",
              "loaded",
              "reset"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "status"
        ],
        "title": "EditorResponse"
      },
      "EditorState-Input": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "viewport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Viewport"
              },
              {
                "type": "null"
              }
            ]
          },
          "layers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/LayerPref"
            },
            "propertyNames": {
              "maxLength": 64
            },
            "type": "object",
            "maxProperties": 64,
            "title": "Layers",
            "default": {}
          },
          "exaggeration": {
            "type": "number",
            "title": "Exaggeration",
            "default": 3.0,
            "ge": 1,
            "le": 10
          },
          "hole": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Hole",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EditorState",
        "description": "`.course_maker/editor.json`: UI state, per user. Safe to delete; never needed to rebuild a bundle."
      },
      "EditorState-Output": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "viewport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Viewport"
              },
              {
                "type": "null"
              }
            ]
          },
          "layers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/LayerPref"
            },
            "propertyNames": {
              "maxLength": 64
            },
            "type": "object",
            "maxProperties": 64,
            "title": "Layers",
            "default": {}
          },
          "exaggeration": {
            "type": "number",
            "title": "Exaggeration",
            "default": 3.0,
            "ge": 1,
            "le": 10
          },
          "hole": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Hole",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "viewport",
          "layers",
          "exaggeration",
          "hole"
        ],
        "title": "EditorState",
        "description": "`.course_maker/editor.json`: UI state, per user. Safe to delete; never needed to rebuild a bundle."
      },
      "ElevationLayer": {
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "hMin": {
            "type": "number",
            "title": "Hmin"
          },
          "hMax": {
            "type": "number",
            "title": "Hmax"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height",
          "hMin",
          "hMax"
        ],
        "title": "ElevationLayer",
        "description": "16-bit heights in R/G of a PNG, as in the bundle format; A = 0 marks no data."
      },
      "Grid": {
        "properties": {
          "file": {
            "type": "string",
            "pattern": "\\S",
            "title": "File"
          },
          "cols": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Cols"
          },
          "rows": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rows"
          },
          "res": {
            "type": "number",
            "title": "Res",
            "gt": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file",
          "cols",
          "rows",
          "res"
        ],
        "title": "Grid"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hole": {
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Number"
          },
          "par": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Par"
          },
          "route": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "minItems": 2,
            "title": "Route"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "par",
          "route"
        ],
        "title": "Hole"
      },
      "Index": {
        "properties": {
          "root": {
            "type": "string",
            "title": "Root"
          },
          "tifs": {
            "items": {
              "$ref": "#/components/schemas/TifEntry"
            },
            "type": "array",
            "title": "Tifs"
          },
          "bundles": {
            "items": {
              "$ref": "#/components/schemas/BundleEntry"
            },
            "type": "array",
            "title": "Bundles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "root",
          "tifs",
          "bundles"
        ],
        "title": "Index"
      },
      "Landmark": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "pattern": "\\S",
            "title": "Kind"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "z": {
            "type": "number",
            "title": "Z"
          },
          "rotation": {
            "type": "number",
            "title": "Rotation",
            "default": 0.0
          },
          "scale": {
            "type": "number",
            "title": "Scale",
            "default": 1.0,
            "gt": 0
          },
          "y": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "x",
          "z",
          "rotation",
          "scale",
          "y"
        ],
        "title": "Landmark"
      },
      "LayerPref": {
        "properties": {
          "visible": {
            "type": "boolean",
            "title": "Visible"
          },
          "opacity": {
            "type": "number",
            "title": "Opacity",
            "ge": 0,
            "le": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "visible",
          "opacity"
        ],
        "title": "LayerPref"
      },
      "Patch": {
        "properties": {
          "file": {
            "type": "string",
            "pattern": "\\S",
            "title": "File"
          },
          "x0": {
            "type": "integer",
            "title": "X0"
          },
          "z0": {
            "type": "integer",
            "title": "Z0"
          },
          "cellsX": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Cellsx"
          },
          "cellsZ": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Cellsz"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file",
          "x0",
          "z0",
          "cellsX",
          "cellsZ"
        ],
        "title": "Patch"
      },
      "RasterLayer": {
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "title": "RasterLayer"
      },
      "Report": {
        "properties": {
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors",
            "default": []
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "sizes": {
            "additionalProperties": {
              "type": "integer"
            },
