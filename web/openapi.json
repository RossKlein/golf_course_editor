    "/api/bundle/editor": {
      "get": {
        "summary": "Editor Get",
        "description": "The saved editor state (defaults when there is none or it is unreadable).",
        "operationId": "editor_get_api_bundle_editor_get",
        "parameters": [
          {
            "name": "path",
