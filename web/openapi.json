    "/files/{rel}": {
      "get": {
        "summary": "Bundle File",
        "description": "A file of a bundle (course.json, PNGs, trees.bin), exactly as the game will download it.",
        "operationId": "bundle_file_files__rel__get",
        "parameters": [
          {
            "name": "rel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rel"
            }
