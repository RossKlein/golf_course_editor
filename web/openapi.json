    },
    "/api/bake": {
      "post": {
        "summary": "Bake Bundle",
        "operationId": "bake_bundle_api_bake_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BakeResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
